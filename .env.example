# Server Port & Environment
PORT=3000
NODE_ENV=development

# Cryptographic Session Secret for HttpOnly Cookie Signing
SESSION_SECRET=replace_with_a_secure_random_32_character_string

# Supabase PostgreSQL Database Credentials (Direct Connection for Local Development)
SUPABASE_DB_HOST=db.vaaukirzwhufortgafmn.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your_supabase_db_password
SUPABASE_DB_NAME=postgres

# Alternative IPv4 Pooler Credentials (Recommended for Vercel, AWS Lambda & Cloud Deployments)
SUPABASE_POOLER_HOST=aws-0-ap-southeast-1.pooler.supabase.com
SUPABASE_POOLER_PORT=6543
SUPABASE_POOLER_USER=postgres.vaaukirzwhufortgafmn

# Supabase REST Credentials (optional)
SUPABASE_URL=https://vaaukirzwhufortgafmn.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Google Drive Direct API v3 (No Google Script Required)
# Target Folder ID from your Google Drive URL: drive.google.com/drive/folders/<FOLDER_ID>
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id

# Option A: Google Cloud Service Account (Recommended for automated server uploads)
# Create a free Service Account in Google Cloud Console, download the JSON key,
# and share your Google Drive Folder with this service account email as "Editor".
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Option B: OAuth2 Client (Alternative)
# GOOGLE_CLIENT_ID=your_oauth_client_id
# GOOGLE_CLIENT_SECRET=your_oauth_client_secret
# GOOGLE_REFRESH_TOKEN=your_oauth_refresh_token
