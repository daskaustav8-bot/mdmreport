{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "supabase-client.js",
          "manage_infrastructure_fields.js",
          "style.css",
          "school_master.csv",
          "*.html"
        ]
      }
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/infra_login_handler.php",
      "dest": "/api/index.js"
    },
    {
      "src": "/admin_login_handler.php",
      "dest": "/api/index.js"
    },
    {
      "src": "/logout.php",
      "dest": "/api/index.js"
    },
    {
      "src": "/logout",
      "dest": "/api/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ]
}
